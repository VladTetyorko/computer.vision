        <mxCell id="f12" value="its own state" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;" edge="1" parent="21" source="m2" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
