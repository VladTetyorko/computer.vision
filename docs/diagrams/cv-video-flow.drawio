<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="1 · End-to-end video → CV" id="flow-e2e">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="bandA" value="1 · CAPTURE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b0b0b0;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1570" height="110" as="geometry"/></mxCell>
        <mxCell id="bandB" value="2 · MEDIA SOURCE OF TRUTH — one path per stream, everyone subscribes to it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#8fb8e0;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#2a5d8f;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1570" height="110" as="geometry"/></mxCell>
        <mxCell id="bandC" value="3 · cv-service (Python) — where the pixels become numbers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3fbf3;strokeColor=#8fc98f;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#2f6d2f;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1570" height="330" as="geometry"/></mxCell>
        <mxCell id="bandD" value="4 · JVM — the numbers become domain facts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf6ec;strokeColor=#e0b878;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#8a5c14;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1570" height="200" as="geometry"/></mxCell>
        <mxCell id="bandE" value="5 · OPERATOR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f0fa;strokeColor=#c0a0d0;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#6b3f85;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1570" height="110" as="geometry"/></mxCell>

        <mxCell id="src" value="&lt;b&gt;Camera / drone video&lt;/b&gt;&lt;br/&gt;RTSP · MJPEG · USB (V4L2) · simulation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="ingest" value="&lt;b&gt;ingest adapter&lt;/b&gt;&lt;br/&gt;adapter-rtsp / -mjpeg / -v4l2 / -simulation&lt;br/&gt;&lt;i&gt;normalises + publishes H.264&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="mav" value="&lt;b&gt;MAVLink telemetry&lt;/b&gt;&lt;br/&gt;attitude → camera pose&lt;br/&gt;&lt;i&gt;rides the gRPC request, not the video&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1230" y="90" width="330" height="70" as="geometry"/></mxCell>

        <mxCell id="mtx" value="&lt;b&gt;mediamtx&lt;/b&gt;&lt;br/&gt;one path per stream — the single source of truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e9fb;strokeColor=#2a5d8f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="225" width="300" height="55" as="geometry"/></mxCell>
        <mxCell id="view" value="&lt;b&gt;viewing&lt;/b&gt; — HLS / WHEP&lt;br/&gt;&lt;i&gt;never goes through CV&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a5d8f;" vertex="1" parent="1"><mxGeometry x="880" y="225" width="240" height="55" as="geometry"/></mxCell>

        <mxCell id="p1" value="&lt;b&gt;PullSource&lt;/b&gt;&lt;br/&gt;cv2.VideoCapture (FFMPEG)&lt;br/&gt;&lt;i&gt;cv-service dials RTSP itself&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6d2f;" vertex="1" parent="1"><mxGeometry x="70" y="365" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;reader thread&lt;/b&gt;&lt;br/&gt;single-slot mailbox, always overwrites&lt;br/&gt;&lt;i&gt;freshness &gt; completeness&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6d2f;" vertex="1" parent="1"><mxGeometry x="310" y="365" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;DeadlineSampler&lt;/b&gt;&lt;br/&gt;target_fps · debt clamp&lt;br/&gt;&lt;i&gt;not-selected ≠ dropped&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6d2f;" vertex="1" parent="1"><mxGeometry x="570" y="365" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;b&gt;CaptureClock&lt;/b&gt;&lt;br/&gt;capturedAt = anchor + (pts − anchorPts)&lt;br/&gt;&lt;i&gt;capture time, never arrival time&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3f3;strokeColor=#c05050;" vertex="1" parent="1"><mxGeometry x="800" y="365" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;downscale&lt;/b&gt;&lt;br/&gt;≤ 640 px wide, aspect kept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6d2f;" vertex="1" parent="1"><mxGeometry x="1090" y="365" width="180" height="70" as="geometry"/></mxCell>

        <mxCell id="q1" value="&lt;b&gt;InferenceGate&lt;/b&gt;&lt;br/&gt;bounds concurrent YOLO passes&lt;br/&gt;&lt;i&gt;the tracker never takes it&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6d2f;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="q2" value="&lt;b&gt;detector&lt;/b&gt; — YOLO (ModelRegistry)&lt;br/&gt;≈ 20 ms/frame&lt;br/&gt;&lt;i&gt;runs only when the scheduler says so&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e8;strokeColor=#2f6d2f;fontStyle=1" vertex="1" parent="1"><mxGeometry x="320" y="470" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="q3" value="&lt;b&gt;StreamTrackingSession&lt;/b&gt; — one per stream&lt;br/&gt;identity across frames · 0.14 – 2.2 ms&lt;br/&gt;&lt;i&gt;see page 2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe9cf;strokeColor=#2f6d2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="470" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="q4" value="&lt;b&gt;DetectionResponse&lt;/b&gt;&lt;br/&gt;boxes + track ids + velocity&lt;br/&gt;+ served capability level, lag, ORU stats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6d2f;" vertex="1" parent="1"><mxGeometry x="930" y="470" width="290" height="70" as="geometry"/></mxCell>

        <mxCell id="cost" value="&lt;b&gt;Measured cost of one frame&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;decode ≈ 2 – 4 ms&lt;br/&gt;detector ≈ 20 ms  ← dominates&lt;br/&gt;associate 0.14 – 2.2 ms&lt;br/&gt;&lt;br/&gt;&lt;i&gt;This is why FOLLOW duty-cycles the&lt;br/&gt;detector to ~2 s and lets the tracker&lt;br/&gt;carry every frame in between:&lt;br/&gt;≈ 30× fewer detector passes.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#c9a227;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="365" width="290" height="245" as="geometry"/></mxCell>

        <mxCell id="j1" value="&lt;b&gt;adapter-cv-grpc&lt;/b&gt;&lt;br/&gt;DetectionFrameCodec&lt;br/&gt;&lt;i&gt;wire → domain records&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a5c14;" vertex="1" parent="1"><mxGeometry x="70" y="715" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="j2" value="&lt;b&gt;StreamPipeline&lt;/b&gt; (vision-perception)&lt;br/&gt;orchestrates sampling, CV, publish&lt;br/&gt;&lt;i&gt;degrades if cv-service is gone&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeeda;strokeColor=#8a5c14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="715" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="j3" value="&lt;b&gt;overlay burn-in&lt;/b&gt;&lt;br/&gt;adapter-overlay (Java2D)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a5c14;" vertex="1" parent="1"><mxGeometry x="650" y="715" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="j4" value="&lt;b&gt;SSE live updates&lt;/b&gt;&lt;br/&gt;boxes, ids, tracking telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a5c14;" vertex="1" parent="1"><mxGeometry x="870" y="715" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="j5" value="&lt;b&gt;vision-events&lt;/b&gt;&lt;br/&gt;replay capture · usage timeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a5c14;" vertex="1" parent="1"><mxGeometry x="1130" y="715" width="230" height="70" as="geometry"/></mxCell>

        <mxCell id="ui1" value="&lt;b&gt;Fly cockpit&lt;/b&gt; — video + boxes + track ids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe3f5;strokeColor=#6b3f85;" vertex="1" parent="1"><mxGeometry x="70" y="925" width="330" height="55" as="geometry"/></mxCell>
        <mxCell id="ui2" value="&lt;b&gt;CV control panel&lt;/b&gt; — level ceiling, served level + reason, detection lag vs 50 ms budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe3f5;strokeColor=#6b3f85;" vertex="1" parent="1"><mxGeometry x="430" y="925" width="500" height="55" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="src" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="publish" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="ingest" target="mtx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="subscribe (viewing)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="mtx" target="view"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="subscribe (CV pulls its own copy)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="mtx" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
