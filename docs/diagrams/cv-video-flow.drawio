  </diagram>

  <diagram name="2 · Inside one frame" id="flow-frame">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="20"/>
        <mxCell id="21" parent="20"/>

        <mxCell id="t0" value="frame arrives&lt;br/&gt;(+ its capture time)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e8f5e8;strokeColor=#2f6d2f;fontStyle=1;" vertex="1" parent="21"><mxGeometry x="60" y="70" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="t1" value="&lt;b&gt;scheduler.decide()&lt;/b&gt;&lt;br/&gt;pure — runs &lt;i&gt;before any pixel is touched&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#c9a227;" vertex="1" parent="21"><mxGeometry x="300" y="55" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="t2" value="&lt;b&gt;detect()&lt;/b&gt; — full YOLO pass&lt;br/&gt;≈ 20 ms · the &lt;i&gt;only&lt;/i&gt; InferenceGate acquisition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e8;strokeColor=#2f6d2f;" vertex="1" parent="21"><mxGeometry x="620" y="30" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;tracker-only frame&lt;/b&gt;&lt;br/&gt;coast on motion alone — this is the duty cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="21"><mxGeometry x="620" y="120" width="300" height="60" as="geometry"/></mxCell>

        <mxCell id="t4" value="&lt;b&gt;motion.estimate()&lt;/b&gt; — ego-motion&lt;br/&gt;from camera pose (H = K·R·K⁻¹, ≈ free) or optical flow&lt;br/&gt;&lt;i&gt;skipped for bytetrack: no seam to warp&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6d2f;" vertex="1" parent="21"><mxGeometry x="560" y="230" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="t5" value="&lt;b&gt;book.warp(transform)&lt;/b&gt; — every live track, before anything reads one&lt;br/&gt;&lt;i&gt;so a stalled track accumulates N frames of camera motion, not one&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6d2f;" vertex="1" parent="21"><mxGeometry x="530" y="330" width="480" height="60" as="geometry"/></mxCell>

        <mxCell id="m0" value="mode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#c9a227;" vertex="1" parent="21"><mxGeometry x="700" y="430" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;ASSOCIATE · cost&lt;/b&gt; (L1, pure stdlib)&lt;br/&gt;candidates = the book's own tracks&lt;br/&gt;&lt;i&gt;1.9–5.3× faster · 2.2–4.5× more id switches&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe9cf;strokeColor=#2f6d2f;" vertex="1" parent="21"><mxGeometry x="160" y="560" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;ASSOCIATE · bytetrack&lt;/b&gt; (L3, numpy)&lt;br/&gt;two-stage low/high confidence, own Kalman state&lt;br/&gt;&lt;i&gt;no warp, no ORU, no history — bypasses the book&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce9f7;strokeColor=#2a5d8f;" vertex="1" parent="21"><mxGeometry x="530" y="560" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;FOLLOW&lt;/b&gt; (needs pixels — L2+)&lt;br/&gt;re-anchor on best-IoU detection, else visual tracker&lt;br/&gt;&lt;i&gt;never touches the inference gate&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7e8e8;strokeColor=#c05050;" vertex="1" parent="21"><mxGeometry x="930" y="560" width="360" height="80" as="geometry"/></mxCell>

        <mxCell id="b1" value="&lt;b&gt;TrackBook.apply(observations, capturedAt)&lt;/b&gt;&lt;br/&gt;blend velocity · record the real observation in the history ring&lt;br/&gt;&lt;i&gt;predictions are never recorded as evidence&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe9cf;strokeColor=#2f6d2f;fontStyle=0;" vertex="1" parent="21"><mxGeometry x="440" y="690" width="540" height="70" as="geometry"/></mxCell>

        <mxCell id="oru" value="&lt;b&gt;ORU — was there a gap to rebuild?&lt;/b&gt;&lt;br/&gt;reconstruct the missed motion from the two &lt;i&gt;real&lt;/i&gt; observations bracketing the gap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3f3;strokeColor=#c05050;fontStyle=1;" vertex="1" parent="21"><mxGeometry x="440" y="805" width="540" height="60" as="geometry"/></mxCell>

        <mxCell id="gbox" value="&lt;b&gt;…but only if every guard agrees&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf0f0;strokeColor=#c05050;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#a03030;dashed=1;" vertex="1" parent="21"><mxGeometry x="410" y="890" width="600" height="200" as="geometry"/></mxCell>
        <mxCell id="g1" value="gap ≤ max (15 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c05050;fontSize=11;" vertex="1" parent="21"><mxGeometry x="430" y="925" width="270" height="40" as="geometry"/></mxCell>
        <mxCell id="g2" value="implied velocity ≤ 5.0 frame-widths/s&lt;br/&gt;&lt;i&gt;−64 % impossible velocities&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c05050;fontSize=11;" vertex="1" parent="21"><mxGeometry x="720" y="925" width="270" height="40" as="geometry"/></mxCell>
        <mxCell id="g3" value="density gate (live tracks ≤ N)&lt;br/&gt;&lt;i&gt;swept: no value paid — ships off&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontColor=#777777;" vertex="1" parent="21"><mxGeometry x="430" y="980" width="270" height="40" as="geometry"/></mxCell>
        <mxCell id="g4" value="&lt;b&gt;bracket identity&lt;/b&gt; — same object?&lt;br/&gt;&lt;i&gt;A shape: −97 IDSW · B motion: harmful&lt;br/&gt;both ship off — see results §4d&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontColor=#666666;" vertex="1" parent="21"><mxGeometry x="720" y="975" width="270" height="50" as="geometry"/></mxCell>
        <mxCell id="gnote" value="Any guard refusing ⇒ no reconstruction at all — an implausible rebuild is evidence the bracket is wrong, and a wrong bracket has no salvageable answer. Grey = built, measured, ships disabled: the value it would add is real but conflicts with the one FOLLOW measurement we have." style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#a03030;align=left;" vertex="1" parent="21"><mxGeometry x="430" y="1032" width="560" height="55" as="geometry"/></mxCell>

        <mxCell id="out" value="&lt;b&gt;FrameOutcome&lt;/b&gt;&lt;br/&gt;boxes · ids · velocity · detectorRan + why · engine served · lag · level served" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e8f5e8;strokeColor=#2f6d2f;fontStyle=1;" vertex="1" parent="21"><mxGeometry x="1090" y="800" width="330" height="90" as="geometry"/></mxCell>

        <mxCell id="lvl" value="&lt;b&gt;The capability ladder gates all of this&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;L1 RELAY&lt;/b&gt; ~13 MiB · pure stdlib · ARMv6&lt;br/&gt;&lt;b&gt;L2 FILL&lt;/b&gt; + OpenCV&lt;br/&gt;&lt;b&gt;L3 DETECT&lt;/b&gt; + local YOLO (~350 MiB)&lt;br/&gt;&lt;b&gt;L4 IDENTIFY&lt;/b&gt; + re-ID&lt;br/&gt;&lt;b&gt;L5 STUDY&lt;/b&gt; + training&lt;br/&gt;&lt;br/&gt;&lt;i&gt;A level is a CEILING, not a demand:&lt;br/&gt;the session serves min(requested, affordable),&lt;br/&gt;reports what it served and why it capped,&lt;br/&gt;and never raises.&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Engines are filtered by level &lt;i&gt;before&lt;/i&gt; any&lt;br/&gt;factory runs — ask for bytetrack at L1 and&lt;br/&gt;you get cost, with numpy never imported." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f0fa;strokeColor=#6b3f85;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="21"><mxGeometry x="60" y="230" width="380" height="300" as="geometry"/></mxCell>

        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="21" source="t0" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="21" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="21" source="t1" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="21" source="t2" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="21" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="21" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="21" source="t5" target="m0"><mxGeometry relative="1" as="geometry"/></mxCell>
