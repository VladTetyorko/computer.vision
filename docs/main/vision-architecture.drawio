<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17" type="device">
  <diagram id="ctx" name="1 · Context (C4 L1)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="c_title" value="&lt;b&gt;Vision — system context&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Who uses the platform, what it is pointed at, and what comes out of it. Detail: pages 2–6.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="900" height="60" as="geometry" /></mxCell>

        <mxCell id="c_pilot" value="&lt;b&gt;Drone operator / pilot&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Flies, watches the live feed, drops marks, corrects what the model got wrong&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="230" height="110" as="geometry" /></mxCell>
        <mxCell id="c_cmd" value="&lt;b&gt;Commander / crew&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Watches the common operational picture, verifies and promotes marks, assigns assets&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="230" height="110" as="geometry" /></mxCell>
        <mxCell id="c_trainer" value="&lt;b&gt;CV trainer&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Captures frames from live video, labels them, fine-tunes and promotes a model&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="230" height="110" as="geometry" /></mxCell>
        <mxCell id="c_maker" value="&lt;b&gt;Maker / installer&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Connects an odd source, probes it before saving, runs preflight&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="110" width="230" height="110" as="geometry" /></mxCell>
        <mxCell id="c_admin" value="&lt;b&gt;Fleet admin&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Users, groups, roles, categories, layer grants, audit trail&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1160" y="110" width="230" height="110" as="geometry" /></mxCell>

        <mxCell id="c_sys" value="&lt;b&gt;Vision platform&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Software system]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Ingests video and telemetry from anything, detects and tracks objects, burns overlays,&lt;br&gt;re-streams and records, geolocates what it sees onto a shared map, raises events,&lt;br&gt;and lets an operator teach it new objects.&lt;br&gt;&lt;br&gt;Hexagonal core — it never knows which protocol a frame came from,&lt;br&gt;nor how inference is implemented.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="440" width="600" height="280" as="geometry" /></mxCell>

        <mxCell id="c_src_hdr" value="&lt;b&gt;Sources — &quot;point anything with a camera at the world&quot;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="380" height="20" as="geometry" /></mxCell>
        <mxCell id="c_ipcam" value="&lt;b&gt;IP camera&lt;/b&gt; · RTSP H.264/H.265, ONVIF, mDNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="c_esp" value="&lt;b&gt;ESP32-CAM&lt;/b&gt; · MJPEG over HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="c_usb" value="&lt;b&gt;USB camera / capture dongle&lt;/b&gt; · V4L2 · UVC&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;analog FPV arrives here&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="c_fc" value="&lt;b&gt;Drone flight controller&lt;/b&gt; · MAVLink 2 / UDP&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ArduPilot · INAV · Betaflight · PX4 (RX today, TX gated)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="c_sitl" value="&lt;b&gt;SITL / simulated fleet&lt;/b&gt; · synthetic video + telemetry&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;every protocol also has a TX half that replays a file&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="c_rc" value="&lt;b&gt;RC transmitter / gamepad&lt;/b&gt; · browser Gamepad API&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sticks relayed to SITL as RC_CHANNELS_OVERRIDE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="360" height="55" as="geometry" /></mxCell>

        <mxCell id="c_out_hdr" value="&lt;b&gt;What comes back out&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="290" width="380" height="20" as="geometry" /></mxCell>
        <mxCell id="c_view" value="&lt;b&gt;Live viewers&lt;/b&gt; · HLS ≈ 6 s · WHEP ≈ 0.3 s&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;browser or phone on the LAN, overlay burned in or drawn as vectors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="320" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="c_rec" value="&lt;b&gt;Recordings and replay&lt;/b&gt; · per-flight timeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="390" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="c_hist" value="&lt;b&gt;History&lt;/b&gt; · detections, events, telemetry, usages, audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="460" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="c_cop" value="&lt;b&gt;Common operational picture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;geolocated marks and drawings on access-scoped layers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="530" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="c_models" value="&lt;b&gt;Model registry&lt;/b&gt; · fine-tuned checkpoints, promote / roll back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="600" width="360" height="55" as="geometry" /></mxCell>
        <mxCell id="c_cmdout" value="&lt;b&gt;Flight commands&lt;/b&gt; · arm · mode · return-home · RC override&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SITL today; a real airframe needs an explicit go&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="670" width="360" height="55" as="geometry" /></mxCell>

        <mxCell id="e_c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_pilot" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c1l" value="fly · watch · mark" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e_c1"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="e_c2" value="verify · promote · assign" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_cmd" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c3" value="capture · label · train · promote" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_trainer" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c4" value="probe · register · preflight" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_maker" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c5" value="govern · audit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_admin" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_s1" value="RTSP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_ipcam" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s2" value="MJPEG" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_esp" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s3" value="V4L2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_usb" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s4" value="MAVLink" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;" edge="1" parent="1" source="c_fc" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;" edge="1" parent="1" source="c_sitl" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s6" value="sticks 33 Hz" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_rc" target="c_sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_rc_pilot" value="hands on the sticks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_pilot" target="c_rc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="165" /><mxPoint x="30" y="698" /></Array></mxGeometry></mxCell>

        <mxCell id="e_o1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_sys" target="c_view"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_o2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_sys" target="c_rec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_o3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_sys" target="c_hist"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_o4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_sys" target="c_cop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_o5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_sys" target="c_models"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_o6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c_sys" target="c_cmdout"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="c_legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Dark blue = person · Blue = the platform · Grey = something outside it&lt;br&gt;Red edges = a human is inside that control loop (page 5)&lt;br&gt;Dashed boxes on later pages = a deployment or module boundary&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="480" height="110" as="geometry" /></mxCell>
        <mxCell id="c_note" value="&lt;b&gt;The one rule that shapes everything&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Every box on the left and right of this page is an &lt;i&gt;adapter&lt;/i&gt; concern. None of them appear in the core.&lt;br&gt;Adding a protocol, a detector, a store or a UI is a new module behind an existing port — page 3 shows the wall.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="780" width="940" height="110" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="containers" name="2 · Containers (C4 L2)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="k_title" value="&lt;b&gt;Containers — what runs, and what talks to what&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Four deployables: the SPA (served from the jar), the Spring Boot app, the Python CV service, and two infrastructure sidecars.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1000" height="60" as="geometry" /></mxCell>

        <mxCell id="k_people" value="&lt;b&gt;Operator · Commander · Trainer · Admin&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt; — one human wearing different hats, not four products" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="560" height="70" as="geometry" /></mxCell>

        <mxCell id="k_spa" value="&lt;b&gt;vision-web&lt;/b&gt; &lt;i&gt;[Container: Angular 21 SPA]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Hubs: Operate (Fly · Wall · Map) · Monitor (Command · Alerts · Activity · Replay · Reports) · Manage (Assets · Devices · Roster · Org · Training · Labeling · Models · Settings)&lt;br&gt;Layering: Component → Facade → Store → Service. Built into the jar by frontend-maven-plugin.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="230" width="800" height="110" as="geometry" /></mxCell>

        <mxCell id="k_app" value="&lt;b&gt;vision-app&lt;/b&gt; &lt;i&gt;[Container: Spring Boot 4, Java 21, virtual threads]&lt;/i&gt; — the runnable jar, the only module that knows every adapter" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F9FD;strokeColor=#2E6295;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontColor=#1A3A5C;" vertex="1" parent="1"><mxGeometry x="440" y="420" width="920" height="530" as="geometry" /></mxCell>

        <mxCell id="k_api" value="&lt;b&gt;vision-api&lt;/b&gt; — driving adapter&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;33 REST controllers · SSE live plane (/api/live) · WebSocket /ws/manual-control · HLS reverse proxy · DTOs · CurrentUser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="860" height="75" as="geometry" /></mxCell>
        <mxCell id="k_appl" value="&lt;b&gt;vision-application&lt;/b&gt; — use cases and orchestration&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;asset · device · stream · category · discovery · map · mark · geofence · identity · training · replay · usage · flight · simulation · fleet&lt;br&gt;pipeline/: StreamPipeline · UsageTracker · DetectionEventEngine · TrackBook · GeofenceMonitor · SupervisedPublisher&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="565" width="860" height="90" as="geometry" /></mxCell>
        <mxCell id="k_dom" value="&lt;b&gt;vision-domain&lt;/b&gt; — framework-free model plus 36 driven ports&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;no Spring, no third-party import anywhere in the module&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E3A78;strokeColor=#422954;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="675" width="860" height="65" as="geometry" /></mxCell>
        <mxCell id="k_ada" value="&lt;b&gt;driven adapters&lt;/b&gt; — one module per protocol, never depending on each other&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rtsp · mjpeg · v4l2 · simulation · mavlink · cv-grpc · overlay · publish-hls · discovery · persistence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="760" width="860" height="70" as="geometry" /></mxCell>
        <mxCell id="k_wiring" value="&lt;b&gt;wiring · security · bootstrap · devsupport&lt;/b&gt; — config/wiring/*, Spring Security (only here), demo seed, ArchUnit rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#8CA4BB;fontColor=#24435E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="850" width="860" height="50" as="geometry" /></mxCell>

        <mxCell id="k_srcs" value="&lt;b&gt;Sources&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IP camera (RTSP/ONVIF)&lt;br&gt;ESP32-CAM (MJPEG)&lt;br&gt;USB / capture (V4L2)&lt;br&gt;Flight controller (MAVLink UDP)&lt;br&gt;SITL + synthetic simulation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="280" height="160" as="geometry" /></mxCell>
        <mxCell id="k_pad" value="&lt;b&gt;Gamepad / RC transmitter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;read in the browser, not by the server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="280" height="70" as="geometry" /></mxCell>

        <mxCell id="k_cv" value="&lt;b&gt;cv-service&lt;/b&gt; &lt;i&gt;[Container: Python, gRPC :50051]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ultralytics YOLO · ModelRegistry (composite model ids) · per-stream tracking session (ASSOCIATE / FOLLOW duty cycle) · fine-tuning jobs · echo fallback when no model backend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="440" width="330" height="140" as="geometry" /></mxCell>
        <mxCell id="k_mtx" value="&lt;b&gt;mediamtx&lt;/b&gt; &lt;i&gt;[Container: media server]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;RTSP in :8554 · LL-HLS out :8888 · WHEP out :8889 · playback API for clip export&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="620" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="k_pg" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt; &lt;i&gt;[Container: database]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;assets · devices · usages · telemetry · detections · events · marks · layers · datasets · users · audit&lt;br&gt;opt-in: vision.persistence.enabled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="780" width="330" height="120" as="geometry" /></mxCell>

        <mxCell id="ke1" value="HTTPS · REST/JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;exitX=0.35;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="k_spa" target="k_api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke2" value="SSE /api/live&lt;br&gt;fleet · devices · telemetry:&amp;lt;asset&amp;gt; · detections:&amp;lt;asset&amp;gt; · events · map" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2F7D5B;endArrow=blockThin;endFill=1;startArrow=none;exitX=0.6;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="k_api" target="k_spa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="986" y="400" /><mxPoint x="980" y="400" /></Array></mxGeometry></mxCell>
        <mxCell id="ke3" value="WS /ws/manual-control" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="k_spa" target="k_api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke4" value="Gamepad API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="k_pad" target="k_spa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke5" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="k_people" target="k_spa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke6" value="HLS / WHEP straight to the media server&lt;br&gt;(HLS may be reverse-proxied through the app)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2E6295;dashed=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k_spa" target="k_mtx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1605" y="263" /></Array></mxGeometry></mxCell>

        <mxCell id="ke7" value="RTSP · MJPEG · V4L2 · MAVLink" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B4661E;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;" edge="1" parent="1" source="k_srcs" target="k_ada"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="550" /><mxPoint x="400" y="795" /></Array></mxGeometry></mxCell>
        <mxCell id="ke8" value="gRPC bidi&lt;br&gt;DetectStream · Training" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B4661E;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="k_ada" target="k_cv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="778" /><mxPoint x="1400" y="510" /></Array></mxGeometry></mxCell>
        <mxCell id="ke9" value="RTSP push (H.264)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B4661E;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="k_ada" target="k_mtx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="795" /><mxPoint x="1400" y="680" /></Array></mxGeometry></mxCell>
        <mxCell id="ke10" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B4661E;endArrow=blockThin;endFill=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;" edge="1" parent="1" source="k_ada" target="k_pg"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="k_dep" value="&lt;b&gt;Dependency rule, enforced by ArchUnit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;domain ← application ← adapters ← app. Nothing points outward.&lt;br&gt;Adapters never depend on each other; a shared need becomes a port or a domain type.&lt;br&gt;Spring appears only in vision-app, vision-api and adapters — never in domain or application.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="330" height="120" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="hex" name="3 · Hexagon (ports and adapters)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="h_title" value="&lt;b&gt;The hexagon — driving side, core, driven side&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Left: who calls in. Middle: the part that would still compile if every protocol vanished. Right: the ports the core calls out through, and who implements them.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1200" height="60" as="geometry" /></mxCell>

        <mxCell id="h_core" value="&lt;b&gt;THE CORE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;no framework · no protocol · no vendor&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F3EEF7;strokeColor=#5E3A78;strokeWidth=3;verticalAlign=top;spacingTop=14;fontSize=15;fontColor=#422954;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="700" height="1000" as="geometry" /></mxCell>

        <mxCell id="h_app" value="&lt;b&gt;vision-application&lt;/b&gt; — use cases, one interface plus one Default implementation per area&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;services&lt;/b&gt;  AssetService · DeviceService · StreamService · CategoryService · DiscoveryService · ProbeService&lt;br&gt;MapLayerService · MarkService · DrawingService · GeofenceService · ReplayService · UsageService&lt;br&gt;AuthService · UserService · GroupService · AssignmentService · ActivityService · FleetSummaryService&lt;br&gt;DatasetService · LabelingService · TrainingJobService · ModelRegistryService&lt;br&gt;FlightCommandService · ManualControlService · SimulationService&lt;br&gt;&lt;br&gt;&lt;b&gt;pipeline&lt;/b&gt;  StreamPipeline · UsageTracker · DetectionEventEngine · TrackBook · DetectionExtrapolator&lt;br&gt;SupervisedPublisher · GeofenceMonitor · VideoSourceRegistry · FeedTransmitterRegistry&lt;br&gt;&lt;br&gt;&lt;b&gt;policy&lt;/b&gt;  ScopeResolver · VisibilityScope · MapAccessPolicy — pure functions over (viewer, ownership)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="250" width="580" height="400" as="geometry" /></mxCell>

        <mxCell id="h_dom" value="&lt;b&gt;vision-domain&lt;/b&gt; — immutable records, validated in compact constructors&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;assets&lt;/b&gt;  Asset · Device · DeviceCategory · AssetUsage · Ownership · LifecycleState&lt;br&gt;&lt;b&gt;perception&lt;/b&gt;  VideoFrame · Detection · TrackRef · TrackingConfig · TargetLock · DetectionResult · AnnotatedFrame&lt;br&gt;&lt;b&gt;flight&lt;/b&gt;  Telemetry · FlightState · FlightCapability · RcChannels · ChannelMap · ControlBinding&lt;br&gt;&lt;b&gt;picture&lt;/b&gt;  Mark · MapLayer · LayerGrant · Drawing · Verification · Affiliation · GeofenceZone&lt;br&gt;&lt;b&gt;learning&lt;/b&gt;  Dataset · TrainingSample · Annotation · TrainingJobSpec · ModelRef&lt;br&gt;&lt;b&gt;identity&lt;/b&gt;  User · Group · Membership · Role · AuditEntry&lt;br&gt;&lt;b&gt;pure math&lt;/b&gt;  GeoProjection — drone pose plus depression angle to a ground point&lt;br&gt;&lt;br&gt;&lt;b&gt;36 driven ports&lt;/b&gt; in port.out. There is deliberately &lt;b&gt;no port.in package&lt;/b&gt;.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E3A78;strokeColor=#422954;fontColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="680" width="580" height="440" as="geometry" /></mxCell>

        <mxCell id="h_drv_hdr" value="&lt;b&gt;DRIVING SIDE&lt;/b&gt; — adapters that call the core" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1F5A40;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="420" height="30" as="geometry" /></mxCell>
        <mxCell id="h_spa" value="&lt;b&gt;vision-web SPA&lt;/b&gt; — browser&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the only client; talks REST, SSE, WS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="h_rest" value="&lt;b&gt;REST controllers&lt;/b&gt; (vision-api)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;assets · devices · streams · categories · discovery · probe · map layers / marks / drawings · geofence · events · usages · replay · flight commands · datasets · labeling · training jobs · model registry · cv models · trackers · users · groups · assignments · activity · audit · simulation · system&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="80" y="280" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="h_sse" value="&lt;b&gt;SSE live plane&lt;/b&gt; — /api/live&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;topics, ring buffers, Last-Event-ID resume, 150 ms coalescing, per-viewer scoping on the map topic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="455" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="h_ws" value="&lt;b&gt;WebSocket&lt;/b&gt; — /ws/manual-control&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;engage · channels 33 Hz · ack · watchdog · release&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="420" height="65" as="geometry" /></mxCell>
        <mxCell id="h_sec" value="&lt;b&gt;Spring Security + CurrentUser&lt;/b&gt; (vision-app)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;authentication at the edge only; the acting user travels as a &lt;i&gt;method parameter&lt;/i&gt;, never a constructor dependency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="650" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="h_boot" value="&lt;b&gt;Bootstrap and devsupport&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;auth seed · simulation resume · demo data · in-memory repositories when persistence is off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="755" width="420" height="70" as="geometry" /></mxCell>

        <mxCell id="he1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F5A40;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="h_rest" target="h_app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="he2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F5A40;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="h_sse" target="h_app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="he3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="h_ws" target="h_app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="he4" value="viewer identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F5A40;dashed=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="h_sec" target="h_app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="he5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F5A40;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="h_boot" target="h_app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="he6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E6295;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;" edge="1" parent="1" source="h_spa" target="h_rest"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="h_out_hdr" value="&lt;b&gt;DRIVEN SIDE&lt;/b&gt; — ports the core owns, adapters that implement them" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#7E4715;" vertex="1" parent="1"><mxGeometry x="1390" y="150" width="640" height="30" as="geometry" /></mxCell>

        <mxCell id="p_video" value="&lt;b&gt;VideoSourcePort&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Flow.Publisher&amp;lt;VideoFrame&amp;gt; open/close&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="190" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="a_video" value="&lt;b&gt;adapter-rtsp&lt;/b&gt; (JavaCV/FFmpeg) · &lt;b&gt;adapter-mjpeg&lt;/b&gt; · &lt;b&gt;adapter-v4l2&lt;/b&gt; · &lt;b&gt;adapter-simulation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="190" width="420" height="60" as="geometry" /></mxCell>

        <mxCell id="p_tel" value="&lt;b&gt;TelemetrySourcePort&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="270" width="230" height="55" as="geometry" /></mxCell>
        <mxCell id="a_tel" value="&lt;b&gt;adapter-mavlink&lt;/b&gt; (MAVLink 2 UDP, firmware-aware decode) · &lt;b&gt;adapter-simulation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="270" width="420" height="55" as="geometry" /></mxCell>

        <mxCell id="p_cv" value="&lt;b&gt;DetectionPort&lt;/b&gt;&lt;br&gt;&lt;b&gt;ModelRegistryPort&lt;/b&gt;&lt;br&gt;&lt;b&gt;TrainingPort&lt;/b&gt; · &lt;b&gt;DatasetUploadPort&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="345" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="a_cv" value="&lt;b&gt;adapter-cv-grpc&lt;/b&gt; → cv-service&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bidi DetectStream · StartTraining · UploadDataset · ListModels · PromoteModel. Swappable for an in-JVM ONNX adapter without touching the core.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="345" width="420" height="80" as="geometry" /></mxCell>

        <mxCell id="p_ovl" value="&lt;b&gt;OverlayPort&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="445" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="a_ovl" value="&lt;b&gt;adapter-overlay&lt;/b&gt; — Java2D boxes, labels, confidence, telemetry OSD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="445" width="420" height="50" as="geometry" /></mxCell>

        <mxCell id="p_pub" value="&lt;b&gt;StreamPublisherPort&lt;/b&gt;&lt;br&gt;&lt;b&gt;RecordingPort&lt;/b&gt;&lt;br&gt;&lt;b&gt;ReplayFrameExtractionPort&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="515" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="a_pub" value="&lt;b&gt;adapter-publish-hls&lt;/b&gt; → mediamtx&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;H.264 RTSP push, HLS and WHEP view URLs, recording segments, clip export&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="515" width="420" height="75" as="geometry" /></mxCell>

        <mxCell id="p_disc" value="&lt;b&gt;DeviceDiscoveryPort&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="610" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="a_disc" value="&lt;b&gt;adapter-discovery&lt;/b&gt; — ONVIF · mDNS · V4L2 scanners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="610" width="420" height="50" as="geometry" /></mxCell>

        <mxCell id="p_cmd" value="&lt;b&gt;FlightCommandPort&lt;/b&gt;&lt;br&gt;&lt;b&gt;ManualControlPort&lt;/b&gt;&lt;br&gt;&lt;b&gt;FeedTransmitterPort&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#C8102E;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="680" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="a_cmd" value="&lt;b&gt;adapter-mavlink (TX)&lt;/b&gt; · &lt;b&gt;adapter-rtsp/mjpeg (TX)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;arm · mode · return-home · RC_CHANNELS_OVERRIDE at 33 Hz; every protocol has a TX half that transmits a file over the real wire&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="680" width="420" height="75" as="geometry" /></mxCell>

        <mxCell id="p_repo" value="&lt;b&gt;20 repository ports&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;asset · assetImage · assetUsage · device · category · telemetry · detection · detectionEvent · mark · mapLayer · drawing · geofence · dataset · trainingSample · sampleImage · user · group · assignment&lt;br&gt;+ AuditTrailPort&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="775" width="230" height="130" as="geometry" /></mxCell>
        <mxCell id="a_repo" value="&lt;b&gt;adapter-persistence&lt;/b&gt; — JPA / PostgreSQL, Flyway&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;opt-in via vision.persistence.enabled; the in-memory devsupport implementations satisfy the same ports when it is off — which is exactly why the ports exist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="775" width="420" height="130" as="geometry" /></mxCell>

        <mxCell id="p_live" value="&lt;b&gt;EventPublisherPort&lt;/b&gt;&lt;br&gt;&lt;b&gt;LiveUpdatePublisherPort&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="925" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="a_live" value="&lt;b&gt;vision-api live registry&lt;/b&gt; (SSE) + decorators in vision-app&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the inversion worth noticing: a &lt;i&gt;driving&lt;/i&gt; module implements a &lt;i&gt;driven&lt;/i&gt; port, so the core pushes without ever knowing SSE exists&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="925" width="420" height="60" as="geometry" /></mxCell>

        <mxCell id="p_pwd" value="&lt;b&gt;PasswordHasherPort&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="1005" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="a_pwd" value="&lt;b&gt;vision-app&lt;/b&gt; — BCrypt (Spring Security), so the domain never learns how a password is hashed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="1005" width="420" height="50" as="geometry" /></mxCell>

        <mxCell id="hi1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=10;strokeColor=#7E4715;" edge="1" parent="1" source="a_video" target="p_video"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hi2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=10;strokeColor=#7E4715;" edge="1" parent="1" source="a_tel" target="p_tel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hi3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=10;strokeColor=#7E4715;" edge="1" parent="1" source="a_cv" target="p_cv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hi4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=10;strokeColor=#7E4715;" edge="1" parent="1" source="a_ovl" target="p_ovl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hi5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=10;strokeColor=#7E4715;" edge="1" parent="1" source="a_pub" target="p_pub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hi6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=10;strokeColor=#7E4715;" edge="1" parent="1" source="a_disc" target="p_disc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hi7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=10;strokeColor=#7E4715;" edge="1" parent="1" source="a_cmd" target="p_cmd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hi8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=10;strokeColor=#7E4715;" edge="1" parent="1" source="a_repo" target="p_repo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hi9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=10;strokeColor=#1F5A40;" edge="1" parent="1" source="a_live" target="p_live"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hi10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=10;strokeColor=#7E4715;" edge="1" parent="1" source="a_pwd" target="p_pwd"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="h_calls" value="the core calls out through ports it declares —&lt;br&gt;implementations are chosen once, in vision-app" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7E4715;" vertex="1" parent="1"><mxGeometry x="1300" y="1090" width="330" height="40" as="geometry" /></mxCell>
        <mxCell id="h_arrow" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#7E4715;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="1115" as="sourcePoint" /><mxPoint x="1200" y="1115" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="h_note1" value="&lt;b&gt;Why there is no port.in package&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Driven ports earn their keep — each has several real implementations that are genuinely swapped (rtsp / mjpeg / v4l2 / sim sources; mediamtx or no-op publishers; in-memory or JPA repositories).&lt;br&gt;Driving interfaces did not: one interface per operation meant one file, one import and one constructor parameter to describe a service doing several things, which pushed controllers past ten dependencies. They collapsed into one service interface plus one Default implementation per area, living in vision-application.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="880" width="520" height="180" as="geometry" /></mxCell>
        <mxCell id="h_note2" value="&lt;b&gt;Where authorization lives&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Authentication is edge-only (Spring Security, session). Authorization is a framework-free application-layer policy: ScopeResolver / VisibilityScope / MapAccessPolicy are pure functions over the viewer and an Ownership or LayerGrant, so they are trivially testable and cacheable, and repositories expose scope-aware queries so filtering happens in the store rather than in memory.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1200" width="700" height="140" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="pipeline" name="4 · Stream pipeline (runtime)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s_title" value="&lt;b&gt;One stream, end to end&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;One StreamPipeline per stream on a virtual thread; one stream failing never touches another. Video never blocks on inference.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1000" height="60" as="geometry" /></mxCell>

        <mxCell id="s_lane_tel" value="&lt;b&gt;TELEMETRY LANE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#A8C4DC;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#1D4A6B;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="2040" height="180" as="geometry" /></mxCell>
        <mxCell id="s_tel_src" value="&lt;b&gt;TelemetrySourcePort&lt;/b&gt;&lt;br&gt;adapter-mavlink · simulation&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GPS · attitude · battery · RSSI · FlightState&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="160" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="s_usage" value="&lt;b&gt;UsageTracker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;opens an AssetUsage on start, closes it on stop; appends samples; keeps the freshest sample per asset in memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="160" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="s_telrepo" value="&lt;b&gt;TelemetryRepositoryPort&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;append-only, time-keyed per usage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="160" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="s_geo" value="&lt;b&gt;GeofenceMonitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;KEEP_IN / KEEP_OUT polygons and ceilings; raises GEOFENCE_BREACH on the edge transition only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="160" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="s_telosd" value="&lt;b&gt;telemetry supplier&lt;/b&gt; → OSD&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;read at most once per published frame, must be cheap; a throwing supplier degrades to &quot;no sample&quot;, never to a pipeline failure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="160" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="s_tellive" value="&lt;b&gt;LiveUpdatePublisherPort&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;telemetry:&amp;lt;assetId&amp;gt; SSE topic, coalesced every 150 ms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1570" y="160" width="250" height="90" as="geometry" /></mxCell>

        <mxCell id="se_t1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_tel_src" target="s_usage"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_t2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_usage" target="s_telrepo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_t3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_telrepo" target="s_geo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_t4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_geo" target="s_telosd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_t5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_telosd" target="s_tellive"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s_lane_vid" value="&lt;b&gt;VIDEO LANE — every frame&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F4FA;strokeColor=#B9A4C9;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#422954;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="2040" height="420" as="geometry" /></mxCell>

        <mxCell id="s_dev" value="&lt;b&gt;Source device&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;camera · drone link · file replay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="380" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="s_vsp" value="&lt;b&gt;VideoSourcePort adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;decode to VideoFrame (BGR24 / JPEG / H264 packet)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="380" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="s_sup" value="&lt;b&gt;SupervisedPublisher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reopens a dead source, backoff 1 s → 30 s; one outage event, not one per retry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="380" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="s_pipe" value="&lt;b&gt;StreamPipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Flow.Subscriber&amp;lt;VideoFrame&amp;gt;, one per stream, virtual thread&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="380" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="s_sample" value="&lt;b&gt;Sampler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;inferenceFps 10 · maxInFlight 2 · latest-wins drop. Detection is skipped entirely when detectionEnabled is false.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="380" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="s_detport" value="&lt;b&gt;DetectionPort&lt;/b&gt;&lt;br&gt;adapter-cv-grpc&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bidi gRPC, one session per stream&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1490" y="380" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="s_cv" value="&lt;b&gt;cv-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ModelRegistry resolves model_id per request (composite ids run several models) → YOLO detect → StreamTrackingSession&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1770" y="380" width="250" height="80" as="geometry" /></mxCell>

        <mxCell id="s_track" value="&lt;b&gt;detect-then-track duty cycle&lt;/b&gt; (inside cv-service)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OFF · ASSOCIATE (ByteTrack over detections) · FOLLOW (LK / NCC single-object tracker holds the locked target every frame while the detector drops to a ~2 s verify pass — measured ~30× fewer detector passes)&lt;br&gt;TargetLock restated on every frame, applied only when lockSeq increases, so a dropped frame or a reconnect cannot desynchronize the lock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6BA3DC;strokeColor=#2E6295;fontColor=#0A1F33;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1490" y="490" width="530" height="110" as="geometry" /></mxCell>

        <mxCell id="s_result" value="&lt;b&gt;DetectionResult&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;detections (+ TrackRef: id, state, source, velocity) · inference latency · TrackingTelemetry (detectorRan, reason, engine, lockedTrackId)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E3A78;strokeColor=#422954;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="630" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="s_book" value="&lt;b&gt;TrackBook + DetectionExtrapolator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;books tracks by the id cv-service assigned (it does no association of its own); smooths boxes between inferences instead of freezing them; cleared when the model is re-armed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="630" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="s_ovl" value="&lt;b&gt;OverlayPort&lt;/b&gt; — adapter-overlay&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;boxes, labels, confidence, telemetry OSD burned into the frame. Skipped entirely when overlayBurnIn is false (cheaper encode for SPA-only viewers, which draw vectors instead).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="630" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="s_pubp" value="&lt;b&gt;StreamPublisherPort&lt;/b&gt;&lt;br&gt;adapter-publish-hls&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;H.264 encode, RTSP push&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="630" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="s_mtx2" value="&lt;b&gt;mediamtx&lt;/b&gt; → HLS ≈ 6 s · WHEP ≈ 0.3 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;plus recording segments and clip export&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="630" width="250" height="90" as="geometry" /></mxCell>

        <mxCell id="se_v1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_dev" target="s_vsp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_vsp" target="s_sup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v3" value="all frames" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_sup" target="s_pipe"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v4" value="every Nth frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_pipe" target="s_sample"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v5" value="async · never blocks video" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_sample" target="s_detport"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v6" value="FrameRequest&lt;br&gt;(+ TrackingConfig, TargetLock)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_detport" target="s_cv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E6295;endArrow=blockThin;endFill=1;dashed=1;" edge="1" parent="1" source="s_cv" target="s_track"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v8" value="DetectionResponse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_track" target="s_result"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_result" target="s_book"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v10" value="AnnotatedFrame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_book" target="s_ovl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_ovl" target="s_pubp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_pubp" target="s_mtx2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v13" value="frames pass through even while inference is in flight" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pipe" target="s_book"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_v14" value="OSD sample" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1D4A6B;dashed=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_telosd" target="s_ovl"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s_lane_out" value="&lt;b&gt;FAN-OUT — what else a completed result feeds&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FAF6;strokeColor=#A9CDB8;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#1F5A40;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="2040" height="230" as="geometry" /></mxCell>
        <mxCell id="s_detrepo" value="&lt;b&gt;DetectionRepositoryPort&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;queryable history, joined back to a usage for replay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1490" y="830" width="250" height="80" as="geometry" /></mxCell>
        <mxCell id="s_evt" value="&lt;b&gt;DetectionEventEngine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;debounce: label in filter, confidence ≥ threshold, N consecutive frames to open, 5 s absence to close. Position stamped once, at open.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="830" width="270" height="80" as="geometry" /></mxCell>
        <mxCell id="s_evtpub" value="&lt;b&gt;EventPublisherPort&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DETECTION · STREAM_STARTED/STOPPED · DEVICE_ONLINE/OFFLINE · PIPELINE_ERROR · GEOFENCE_BREACH · TRAINING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="830" width="270" height="80" as="geometry" /></mxCell>
        <mxCell id="s_live2" value="&lt;b&gt;LiveUpdatePublisherPort&lt;/b&gt; → SSE&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;detections:&amp;lt;asset&amp;gt; latest-only · detection-events FIFO · fleet · devices · map (scoped per viewer)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="830" width="270" height="80" as="geometry" /></mxCell>
        <mxCell id="s_spa2" value="&lt;b&gt;vision-web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;vector overlay on the player, alert cards, fleet tiles, map deltas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="830" width="270" height="80" as="geometry" /></mxCell>

        <mxCell id="se_f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_result" target="s_detrepo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_result" target="s_evt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_evt" target="s_evtpub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_f4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_evtpub" target="s_live2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_f5" value="SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F5A40;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_live2" target="s_spa2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se_f6" value="every completed result, empty or not" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F5A40;dashed=1;endArrow=blockThin;endFill=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="s_result" target="s_live2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="700" /></Array></mxGeometry></mxCell>
        <mxCell id="se_f7" value="breach" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1D4A6B;dashed=1;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_geo" target="s_evtpub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="205" /><mxPoint x="945" y="790" /></Array></mxGeometry></mxCell>
        <mxCell id="se_f8" value="HLS / WHEP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2E6295;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s_mtx2" target="s_spa2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s_policy" value="&lt;b&gt;The three policies that make this survivable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Sampling&lt;/b&gt; — inference runs at ~10 fps while video passes at full rate; intermediate frames get extrapolated boxes.&lt;br&gt;&lt;b&gt;Backpressure&lt;/b&gt; — when CV is slow, inference candidates are dropped latest-wins. The video path never waits.&lt;br&gt;&lt;b&gt;Isolation&lt;/b&gt; — one supervised pipeline per stream on its own virtual thread; a failing source reopens behind backoff without disturbing anything else.&lt;br&gt;&lt;i&gt;Failsafe and up-to-date: newer telemetry and newer detections always win over older ones that are still buffered.&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="1100" height="140" as="geometry" /></mxCell>
        <mxCell id="s_ctrl" value="&lt;b&gt;Live control of a running stream&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PATCH /api/streams/{id}/config changes model, confidence, fps, label filter, detection on/off and tracking mode &lt;i&gt;without restarting the stream&lt;/i&gt;.&lt;br&gt;Changing the model re-arms the pipeline: the track book is cleared, because track ids belong to the model that produced them.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="1030" width="900" height="140" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="loops" name="5 · Human-in-the-loop flows">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="l_title" value="&lt;b&gt;Where a human sits inside the machine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Four closed loops. In each one the person is not a spectator — the loop cannot close without them.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1000" height="60" as="geometry" /></mxCell>

        <mxCell id="lA" value="&lt;b&gt;A · TEACH IT A NEW OBJECT&lt;/b&gt; — operator-in-the-loop model improvement (gated by vision.training.enabled)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF7FD;strokeColor=#B9A4C9;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontColor=#422954;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="2000" height="300" as="geometry" /></mxCell>
        <mxCell id="lA1" value="&lt;b&gt;Live stream&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;model is missing the thing the operator cares about&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lA2" value="&lt;b&gt;Capture frame&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TrainingSample PENDING, seeded with the model's own boxes as MODEL annotations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="180" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lA3" value="&lt;b&gt;👤 Operator labels&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;confirm · redraw · discard → LABELED with OPERATOR provenance, stamped with who and when&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#C8102E;strokeWidth=3;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="180" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lA4" value="&lt;b&gt;Dataset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ordered YOLO class list; only LABELED samples are exported&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E3A78;strokeColor=#422954;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="180" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lA5" value="&lt;b&gt;DatasetUploadPort&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gRPC UploadDataset — streams the zip to whichever host trains&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="180" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lA6" value="&lt;b&gt;cv-service trainer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fine-tune from a pretrained checkpoint; TrainingProgress streams loss and mAP50 per epoch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="180" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lA7" value="&lt;b&gt;Model registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;👤 operator promotes a version; rollback is picking the previous one&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#C8102E;strokeWidth=3;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1590" y="180" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lA8" value="&lt;b&gt;PATCH stream config&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;new model id re-arms the live pipeline, no restart&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1840" y="180" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="leA1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lA1" target="lA2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leA2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lA2" target="lA3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leA3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lA3" target="lA4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leA4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lA4" target="lA5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leA5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lA5" target="lA6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leA6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lA6" target="lA7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leA7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lA7" target="lA8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leA8" value="the same stream now finds it — and the operator captures the next miss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FBF7FD;strokeColor=#C8102E;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lA8" target="lA1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1935" y="360" /><mxPoint x="190" y="360" /></Array></mxGeometry></mxCell>

        <mxCell id="lB" value="&lt;b&gt;B · BUILD THE SHARED PICTURE&lt;/b&gt; — detection to verified mark on the common operational picture" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FAF6;strokeColor=#A9CDB8;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontColor=#1F5A40;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="2000" height="300" as="geometry" /></mxCell>
        <mxCell id="lB1" value="&lt;b&gt;Detection + drone pose&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;box on a frame plus GPS, heading, altitude&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="520" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lB2" value="&lt;b&gt;GeoProjection.project&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;slant range from altitude and depression angle, then a great-circle forward projection — an honest estimate, no gimbal telemetry exists&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E3A78;strokeColor=#422954;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lB3" value="&lt;b&gt;👤 Operator drops or drags a Mark&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kind + affiliation (friendly/hostile/neutral/unknown), UNVERIFIED, on a personal or team layer; always draggable because it is an estimate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#C8102E;strokeWidth=3;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="520" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="lB4" value="&lt;b&gt;👤 Reviewer verifies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CONFIRMED or REJECTED, stamped with who and when&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#C8102E;strokeWidth=3;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="520" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lB5" value="&lt;b&gt;Promote to the COP layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one system-wide shared layer; TEAM and PERSONAL layers extend it through explicit grants&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="520" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="lB6" value="&lt;b&gt;Scoped SSE fan-out&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the map topic is the one channel filtered &lt;i&gt;per connection&lt;/i&gt; — a viewer only receives events for layers they may see&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="520" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="lB7" value="&lt;b&gt;👤 Every other operator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sees it within a second, corrects it, clears it when it is gone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#C8102E;strokeWidth=3;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1630" y="520" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="leB1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lB1" target="lB2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leB2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lB2" target="lB3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leB3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lB3" target="lB4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leB4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lB4" target="lB5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leB5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lB5" target="lB6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leB6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F5A40;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lB6" target="lB7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leB7" value="a correction is just another mark event — the picture converges instead of drifting" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#F4FAF6;strokeColor=#C8102E;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lB7" target="lB3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1730" y="700" /><mxPoint x="700" y="700" /></Array></mxGeometry></mxCell>
        <mxCell id="lB_manual" value="&lt;b&gt;or simply: 👤 click the map&lt;/b&gt; — MarkSource MANUAL, same lifecycle from here on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#8CA4BB;fontColor=#24435E;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1880" y="520" width="150" height="80" as="geometry" /></mxCell>
        <mxCell id="leB8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8CA4BB;dashed=1;endArrow=blockThin;endFill=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lB_manual" target="lB3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1955" y="480" /><mxPoint x="850" y="480" /></Array></mxGeometry></mxCell>

        <mxCell id="lC" value="&lt;b&gt;C · FLY IT&lt;/b&gt; — the pilot inside the control loop (SITL today; a real airframe is gated on an explicit go)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF5F6;strokeColor=#E0A6AE;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontColor=#8C1024;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="2000" height="320" as="geometry" /></mxCell>
        <mxCell id="lC1" value="&lt;b&gt;👤 Pilot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;eyes on the video, hands on the sticks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#C8102E;strokeWidth=3;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="870" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="lC2" value="&lt;b&gt;Gamepad in the browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;axes and buttons sampled at 33 Hz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="870" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="lC3" value="&lt;b&gt;WS /ws/manual-control&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;engage → channels → ack (seq, tSent, tServer gives glass-to-stick RTT)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="870" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="lC4" value="&lt;b&gt;ManualControlService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scope check · one session at a time · audit · watchdog&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="870" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="lC5" value="&lt;b&gt;ChannelMap → RcChannels&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;per-binding calibration: min/center/max µs, deadband, reverse&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E3A78;strokeColor=#422954;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="870" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="lC6" value="&lt;b&gt;ManualControlPort&lt;/b&gt;&lt;br&gt;adapter-mavlink&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RC_CHANNELS_OVERRIDE (#70)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B4661E;strokeColor=#7E4715;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="870" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="lC7" value="&lt;b&gt;SITL / vehicle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ArduPilot flies the sticks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="870" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="lC8" value="&lt;b&gt;Video + telemetry back&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OSD, HUD, flight state, arming blockers — closing the loop at the pilot's eyes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1750" y="870" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="leC1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lC1" target="lC2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leC2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lC2" target="lC3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leC3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lC3" target="lC4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leC4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lC4" target="lC5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leC5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lC5" target="lC6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leC6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lC6" target="lC7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leC7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lC7" target="lC8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leC8" value="what the pilot sees decides the next stick input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FDF5F6;strokeColor=#C8102E;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lC8" target="lC1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1845" y="1050" /><mxPoint x="180" y="1050" /></Array></mxGeometry></mxCell>
        <mxCell id="lC_wd" value="&lt;b&gt;Watchdog&lt;/b&gt; — no channel frame within the timeout releases the session and pushes a watchdog frame; closing the socket releases too. The relay is ack-less and never latches." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#C8102E;fontColor=#8C1024;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="550" y="980" width="670" height="60" as="geometry" /></mxCell>
        <mxCell id="lC_cmd" value="&lt;b&gt;One-shot commands&lt;/b&gt; — arm · disarm · set mode · return-home over FlightCommandPort, answered ACCEPTED or NO_ACK; the UI only offers what FlightCapability reports the aircraft accepts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8102E;fontColor=#8C1024;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1270" y="980" width="670" height="60" as="geometry" /></mxCell>

        <mxCell id="lD" value="&lt;b&gt;D · TRIAGE WHAT IT SAW&lt;/b&gt; — the alert list doubles as the labeling queue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#BFBFBF;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="60" y="1150" width="2000" height="220" as="geometry" /></mxCell>
        <mxCell id="lD1" value="&lt;b&gt;DetectionEvent opens&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;debounced, so a flicker is not an alert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1220" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="lD2" value="&lt;b&gt;SSE detection-events&lt;/b&gt; → alert card&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;every card explains itself: model, version, confidence, dwell&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F7D5B;strokeColor=#1F5A40;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="1220" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="lD3" value="&lt;b&gt;👤 Operator judges&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&quot;not a person&quot; / &quot;yes, that is my object&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#C8102E;strokeWidth=3;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="1220" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="lD4" value="&lt;b&gt;Feeds loop A&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a corrected frame is a labeled sample; noise control and training are the same act&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E3A78;strokeColor=#422954;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="1220" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="lD5" value="&lt;b&gt;Tune the rule instead&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;labels, confidence, frames-to-open, absence-to-close — per stream, live&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6E9E;strokeColor=#1D4A6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="1220" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="leD1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lD1" target="lD2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leD2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lD2" target="lD3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leD3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lD3" target="lD4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leD4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C8102E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="lD4" target="lD5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lD_note" value="&lt;font style=&quot;font-size:11px&quot;&gt;Alert noise is the number-one reason products like this get muted and abandoned. Both exits from the operator's judgement — retrain the model, or retune the rule — are one click away from the card itself.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="1420" y="1220" width="610" height="80" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="deploy" name="6 · Deployment">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="d_title" value="&lt;b&gt;Deployment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;One docker-compose brings up the whole platform; inference can be moved to another machine by changing one endpoint.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1000" height="60" as="geometry" /></mxCell>

        <mxCell id="d_host" value="&lt;b&gt;Ops host&lt;/b&gt; — docker compose up" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F9FD;strokeColor=#2E6295;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=14;fontColor=#1A3A5C;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="700" height="640" as="geometry" /></mxCell>
        <mxCell id="d_app" value="&lt;b&gt;vision-app&lt;/b&gt; :8080&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Spring Boot jar — REST, SSE, WS, the SPA, every adapter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="620" height="90" as="geometry" /></mxCell>
        <mxCell id="d_mtx" value="&lt;b&gt;mediamtx&lt;/b&gt; 1.19.3&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;RTSP :8554 · LL-HLS :18888→8888 · WHEP :18889→8889 · ICE/RTP :8189/udp · playback :19996&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="620" height="90" as="geometry" /></mxCell>
        <mxCell id="d_pg" value="&lt;b&gt;postgres&lt;/b&gt; 16 :5432&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Flyway-migrated schema; volume postgres-data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="450" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="d_cvlocal" value="&lt;b&gt;cv-service&lt;/b&gt; :50051&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;optional locally — the app runs with it scaled to zero&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="450" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="d_vol" value="&lt;b&gt;volumes&lt;/b&gt; · postgres-data · mediamtx-recordings&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;healthchecks gate startup order; the app tolerates a missing CV service by design&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#8CA4BB;fontColor=#24435E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="580" width="620" height="70" as="geometry" /></mxCell>
        <mxCell id="d_scale" value="&lt;font style=&quot;font-size:11px&quot;&gt;Core compute scales out by adding CV workers; the stateless app instances scale once live state is externalised (multi-instance SSE fan-out is not built yet).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="480" y="670" width="620" height="70" as="geometry" /></mxCell>

        <mxCell id="d_gb" value="&lt;b&gt;GB4005 inference box&lt;/b&gt; — separate machine on the LAN&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cv-service only · Intel, no CUDA, OpenVINO path · reached by setting VISION_CV_ENDPOINT to host:50051 — the only change needed to move inference off the laptop&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF7FD;strokeColor=#5E3A78;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontColor=#422954;" vertex="1" parent="1"><mxGeometry x="1250" y="130" width="500" height="150" as="geometry" /></mxCell>

        <mxCell id="d_sitl" value="&lt;b&gt;SITL farm&lt;/b&gt; — infra/sitl, its own compose file&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ArduPilot SITL instances + autofly script → MAVLink telemetry over UDP, and synthetic or file-backed video over the real protocols&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FAF6;strokeColor=#1F5A40;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontColor=#1F5A40;" vertex="1" parent="1"><mxGeometry x="1250" y="320" width="500" height="150" as="geometry" /></mxCell>

        <mxCell id="d_edge" value="&lt;b&gt;Edge kit&lt;/b&gt; — infra/edge&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Raspberry Pi companion: mavlink-router, ESP32 bridge, ELRS backpack notes, systemd units. Carries camera and FC traffic from the airframe to the LAN.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7F0;strokeColor=#B4661E;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontColor=#7E4715;" vertex="1" parent="1"><mxGeometry x="1250" y="510" width="500" height="150" as="geometry" /></mxCell>

        <mxCell id="d_field" value="&lt;b&gt;Field hardware&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IP cameras (RTSP/ONVIF)&lt;br&gt;ESP32-CAM (MJPEG)&lt;br&gt;USB and capture devices (V4L2)&lt;br&gt;Flight controllers (MAVLink 2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="280" height="150" as="geometry" /></mxCell>
        <mxCell id="d_client" value="&lt;b&gt;Browsers and phones on the LAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SPA over :8080; media straight from mediamtx (WHEP needs the host's LAN address in the ICE candidates, which is why the compose file sets it explicitly)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="280" height="130" as="geometry" /></mxCell>

        <mxCell id="de1" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="d_client" target="d_app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de2" value="HLS / WHEP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2E6295;dashed=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="d_client" target="d_mtx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="215" /><mxPoint x="410" y="365" /></Array></mxGeometry></mxCell>
        <mxCell id="de3" value="RTSP · MJPEG · V4L2 · MAVLink UDP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;" edge="1" parent="1" source="d_field" target="d_app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="395" /><mxPoint x="410" y="235" /></Array></mxGeometry></mxCell>
        <mxCell id="de4" value="RTSP push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="d_app" target="d_mtx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de5" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="d_app" target="d_pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="430" /></Array></mxGeometry></mxCell>
        <mxCell id="de6" value="gRPC :50051" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="d_app" target="d_cvlocal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="430" /></Array></mxGeometry></mxCell>
        <mxCell id="de7" value="gRPC over the LAN&lt;br&gt;VISION_CV_ENDPOINT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#5E3A78;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" edge="1" parent="1" source="d_app" target="d_gb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de8" value="MAVLink UDP + video" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F5A40;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_sitl" target="d_app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="395" /><mxPoint x="1190" y="253" /></Array></mxGeometry></mxCell>
        <mxCell id="de9" value="relays field traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B4661E;dashed=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="d_edge" target="d_app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="585" /><mxPoint x="1190" y="270" /></Array></mxGeometry></mxCell>

        <mxCell id="d_note" value="&lt;b&gt;Configuration discipline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;No magic numbers in code. Fixed values live in configuration at the root level; anything that varies at runtime lives in the database (with a cache in front) or arrives as a request parameter — which is why models, thresholds, fps, label filters and tracking mode are all PATCHable per stream rather than baked into a profile.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="330" height="190" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
