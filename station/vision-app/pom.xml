<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.drones</groupId>
        <artifactId>vision</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vision-app</artifactId>
    <name>vision-app</name>
    <description>Spring Boot assembly: wiring, configuration, profiles. The only module that knows about all adapters.</description>

    <dependencies>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-warehouse</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-flight</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-perception</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-map</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-events</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-learning</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-simulation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-simulation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-rtsp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-mjpeg</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-mavlink</artifactId>
        </dependency>
        <!--
          Declared explicitly, and it must stay compile-scoped. adapter-mavlink already brings
          mavlink-core transitively, but a direct declaration here wins Maven's nearest-wins race:
          scoping it to `test` stripped the library off the *runtime* classpath entirely, and the
          app booted only to die on NoClassDefFoundError: com/drones/mavlink/session/TxScheduler.
          The declaration is kept rather than dropped so ArchitectureTest can import
          `com.drones.mavlink..` and enforce that the library never depends back on
          `com.drones.vision..` — the guard that keeps it reusable. Importing those classes off disk
          instead would make the rule skip silently whenever the module happened not to be built,
          and a rule that skips is not a rule. See docs/plans/active/MAVLINK-CORE-PLAN.md §3.1.
        -->
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>mavlink-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-v4l2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-publish-hls</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-cv-grpc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-overlay</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-api</artifactId>
        </dependency>
        <!-- Static-only jar: the Angular bundle under META-INF/resources. -->
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!--
          Session auth (docs/plans/done/U-AUTH-PLAN.md, wave 3). Spring Security lives ONLY here in vision-app,
          never in vision-api (a driving adapter): the SecurityContext-reading seam
          (PrincipalResolver/SessionAuthenticator) is implemented in this module. Version managed by
          spring-boot-starter-parent.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
          Liveness probe (docs/plans/active/SYSTEM-STATUS-PLAN.md §4.4): only the `health` endpoint
          is exposed (see application.yaml's management.endpoints.web.exposure.include); metrics,
          env, beans and configprops stay off. Backs docker-compose.yml's vision-app healthcheck and
          makes the vision-web /debug page's Health card (already written to probe /actuator/health)
          work.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
