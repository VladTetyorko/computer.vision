<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.drones</groupId>
        <artifactId>vision</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vision-app</artifactId>
    <name>vision-app</name>
    <description>Spring Boot assembly: wiring, configuration, profiles. The only module that knows about all adapters.</description>

    <dependencies>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-warehouse</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-flight</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-perception</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-map</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-events</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-learning</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-simulation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-simulation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-rtsp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-mjpeg</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-mavlink</artifactId>
        </dependency>
        <!--
          Declared explicitly, at compile scope, for two independent reasons.

          1. RUNTIME. adapter-mavlink's own classes use `com.drones.mavlink..` internally
             (MavlinkManualControlSender → TxScheduler), so the library must be on the *runtime*
             classpath of the assembly. It arrives transitively from adapter-mavlink — but a direct
             declaration here wins over a transitive one (Maven resolves nearest-definition-first),
             so declaring it `test` here demoted the whole app's copy to test-only and the context
             failed to start with NoClassDefFoundError: com/drones/mavlink/session/TxScheduler.
             Tests could never catch that: test scope is precisely the classpath they run on.
             This dependency was test-scoped while W4 was still pending and adapter-mavlink did not
             yet use the library; that premise expired when W4 landed.
          2. ARCHUNIT. ArchitectureTest must be able to import `com.drones.mavlink..` to enforce that
             the library never depends back on `com.drones.vision..` — the guard that keeps it
             reusable. Importing those classes off disk instead would make the rule skip silently
             whenever the module happened not to be built, and a rule that skips is not a rule.
             Compile scope satisfies this too; test scope was never required for it.

          See docs/plans/active/MAVLINK-CORE-PLAN.md §3.1.
        -->
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>mavlink-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-v4l2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-publish-hls</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-cv-grpc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-overlay</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>adapter-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-api</artifactId>
        </dependency>
        <!-- Static-only jar: the Angular bundle under META-INF/resources. -->
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!--
          Session auth (docs/plans/done/U-AUTH-PLAN.md, wave 3). Spring Security lives ONLY here in vision-app,
          never in vision-api (a driving adapter): the SecurityContext-reading seam
          (PrincipalResolver/SessionAuthenticator) is implemented in this module. Version managed by
          spring-boot-starter-parent.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          docs/plans/active/POSTGRES-ONLY-CONTEXT.md W4: vision.persistence.enabled now defaults to true, so
          every @SpringBootTest in this module needs a real Postgres, see
          com.drones.vision.app.testsupport (PostgresContextCustomizerFactory / SharedPostgresContainer /
          PostgresResetTestExecutionListener / DockerGatedExecutionCondition) for the one-container-per-JVM
          wiring. Versions come from spring-boot-dependencies (this module's grandparent POM), no root-pom
          pin needed, same convention adapter-persistence's own pom.xml uses for these two.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PostgresResetTestExecutionListener's between-test-class clean()+migrate(): flyway-core
             already reaches this module's runtime classpath transitively via adapter-persistence, but is
             declared directly here too since testsupport code imports org.flywaydb.core.Flyway. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
