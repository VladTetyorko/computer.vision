<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.drones</groupId>
        <artifactId>vision</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>adapter-persistence</artifactId>
    <name>adapter-persistence</name>
    <description>JPA/Postgres persistence adapter for the fleet-side (categories, devices, assets) and history (usages, telemetry, detections) repository ports.</description>

    <dependencies>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-warehouse</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-flight</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-perception</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-map</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-learning</artifactId>
        </dependency>

        <!-- JPA/Hibernate: versions come from spring-boot-dependencies (this
             module's grandparent POM), no root-pom pin needed, same as
             postgresql/flyway/testcontainers below. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>
        <!-- SCALE-100-PLAN.md S3: a real connection pool for PersistenceUnit's native bootstrap,
             which builds the HikariConfig/HikariDataSource by hand so that ONE pool is shared with
             Flyway. Deliberately NOT org.hibernate.orm:hibernate-hikaricp, an artifact that exists
             only to supply HikariCPConnectionProvider, which always builds a second, unshared pool
             from hibernate.hikari.* properties (see ClosingDatasourceConnectionProvider's javadoc),
             so nothing here would ever load it. Version comes from spring-boot-dependencies (this
             module's grandparent POM: ${hikaricp.version}), no root-pom pin needed, same as
             hibernate-core above. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Attributes/hints columns are jsonb, mapped via Hibernate's native
             JdbcTypeCode(SqlTypes.JSON) support, which auto-detects a Jackson
             ObjectMapper on the classpath (Jackson 3 / tools.jackson, per
             house convention — Hibernate 7.4 ships Jackson3JsonFormatMapper). -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: DevAccountSeedMigrationTest verifies db/seed/dev's hardcoded password
             hashes against their plaintexts with the same BCryptPasswordEncoder vision-app's
             BcryptPasswordHasher wraps (docs/plans/active/POSTGRES-ONLY-CONTEXT.md W1). This module has no
             runtime dependency on Spring Security and never will; version comes from
             spring-boot-dependencies, no root-pom pin needed, same as every other dependency here. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- spring-security-crypto marks spring-core optional (it expects a Spring Boot app to
             already have it); spring-core bundles its own commons-logging bridge (spring-jcl), so
             pulling it in here is the whole fix for BCryptPasswordEncoder's NoClassDefFoundError,
             not a step toward any runtime Spring dependency. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
