# Generated protobuf/gRPC stubs - regenerate with scripts/gen_proto.sh
# (see README.md). Never commit generated code.
cv_service/gen/

__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ultralytics YOLO weights - downloaded on demand (YOLO("yolo11n.pt") drops
# them in the current working directory if not already cached) or baked into
# the Docker image at build time. Never commit model weights.
*.pt
*.onnx
*.engine

# OpenVINO export output (`yolo export ... format=openvino`, see Dockerfile)
# -- Docker-only by convention, but ignore it in case anyone runs the export
# locally by hand.
*_openvino_model/

# Active-model marker written by Training.PromoteModel (cv_service/training/marker.py)
# -- runtime state recording the operator's promoted default, not source.
active_model.json

# Exported YOLO datasets rsync'd onto the training host for Training.StartTraining
# (CV_DATASET_DIR, default <cv-service>/datasets/<dataset_id>/) and the
# ultralytics training run outputs -- runtime data, never source.
datasets/
runs/

# MOT17 real-footage benchmark data (benchmarks/mot17.py, fetch_mot17.sh) --
# CC BY-NC-SA licensed third-party dataset, never committed. Reproduced via
# benchmarks/fetch_mot17.sh; see benchmarks/__init__.py for what this data feeds.
benchmarks/data/

# Visual-geo v2 eval harness (VISUAL-GEO-V2-PLAN.md wave H0, spikes/geo/) -- model weight
# downloads (TORCH_HOME/HF_HOME), fetched Esri tiles, and built region indices are runtime
# artefacts, never source. The parked branch (feat/visual-geo) gitignored spikes/geo/results/
# too and lost every raw measurement -- R11's fix is that results/**/*.json and
# results/**/report.md are explicitly NOT covered by any pattern here and ARE committed.
.model-cache/
spikes/geo/tile_cache/
spikes/geo/regions/
# A shallow `git clone` of the official zju3dv/EfficientLoFTR repo (matchers.py#build_eloftr,
# for the eloftr bake-off candidate) -- a third-party checkout with its own .git dir, never this
# repo's source; `git add` on it stages an embedded-repo gitlink unless ignored explicitly.
spikes/geo/.eloftr-repo/
