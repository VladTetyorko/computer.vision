<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.drones</groupId>
        <artifactId>vision</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>adapter-cv-grpc</artifactId>
    <name>adapter-cv-grpc</name>
    <description>gRPC client to the Python CV service — GrpcDetectionPort over the generated Inference/DetectStream stub.</description>

    <dependencies>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-perception</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-learning</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drones</groupId>
            <artifactId>vision-proto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-process gRPC transport for tests only; version managed by the
             io.grpc:grpc-bom imported via spring-boot-dependencies (not the
             ${grpc.version}=1.64.0 pin used for the wire-facing artifacts
             above via vision-proto) so it matches whatever grpc-core version
             actually ends up mediated onto the classpath. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
