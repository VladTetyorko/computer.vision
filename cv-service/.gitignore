# Generated protobuf/gRPC stubs - regenerate with scripts/gen_proto.sh
# (see README.md). Never commit generated code.
cv_service/gen/

__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ultralytics YOLO weights - downloaded on demand (YOLO("yolo11n.pt") drops
# them in the current working directory if not already cached) or baked into
# the Docker image at build time. Never commit model weights.
*.pt
*.onnx
*.engine

# OpenVINO export output (`yolo export ... format=openvino`, see Dockerfile)
# -- Docker-only by convention, but ignore it in case anyone runs the export
# locally by hand.
*_openvino_model/

# Active-model marker written by Training.PromoteModel (cv_service/training/marker.py)
# -- runtime state recording the operator's promoted default, not source.
active_model.json

# Exported YOLO datasets rsync'd onto the training host for Training.StartTraining
# (CV_DATASET_DIR, default <cv-service>/datasets/<dataset_id>/) and the
# ultralytics training run outputs -- runtime data, never source.
datasets/
runs/
